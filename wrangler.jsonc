{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "tagr-online-platform",
	"compatibility_date": "2024-09-23",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"routes": [
		{
			"pattern": "tagr-online.com/*",
			"zone_name": "tagr-online.com"
		},
		{
			"pattern": "www.tagr-online.com/*",
			"zone_name": "tagr-online.com"
		},
		{
			"pattern": "*.tagr-online.com/*",
			"zone_name": "tagr-online.com"
		},
		{
			"pattern": "online-catalog.net/*",
			"zone_name": "online-catalog.net"
		},
		{
			"pattern": "www.online-catalog.net/*",
			"zone_name": "online-catalog.net"
		}
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	}
}
